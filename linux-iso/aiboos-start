#!/bin/sh
# Start a private local web server for AiboOS; no ports exposed to the LAN.
# Keeps browser storage/PWA on a secure localhost origin instead of file://.
set -eu
PORT=18761
APP_URL="http://127.0.0.1:${PORT}/index.html?desktop-os=1"
if ! curl --silent --fail --max-time 1 "http://127.0.0.1:${PORT}/index.html" >/dev/null 2>&1; then
  # The live image ships AiboOS assets read-only under /opt.
  (cd /opt/aiboos/web && nohup python3 -m http.server "$PORT" --bind 127.0.0.1 >/tmp/aiboos-web.log 2>&1 </dev/null &)
fi
# Don't hide the underlying desktop: users need access to network, settings,
# Calamares disk installer, recovery tools, and the terminal.
exec chromium --app="$APP_URL" --start-maximized --no-first-run --no-default-browser-check --disable-session-crashed-bubble
